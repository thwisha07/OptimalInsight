# Environment example

# Prisma (SQLite by default)
DATABASE_URL="file:./dev.db"

# NextAuth secret (generate a random string for production)
NEXTAUTH_SECRET="change-this-to-a-secure-random-string"

# Optional: admin password for seed (if not set seed will print a random one)
ADMIN_PASSWORD=""

# Optional S3 configuration. If these are set, uploads will be presigned and sent directly to S3.
# Use AWS credentials or an S3-compatible provider (set S3_ENDPOINT for custom endpoint like MinIO or DigitalOcean Spaces)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
S3_BUCKET=""
S3_ENDPOINT="" # optional, e.g. https://nyc3.digitaloceanspaces.com


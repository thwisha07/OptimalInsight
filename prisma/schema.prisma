generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String
  role      String   @default("admin")
  createdAt DateTime @default(now())
}

model System {
  id          String   @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  files       File[]
}

model File {
  id          String   @id @default(cuid())
  system      System   @relation(fields: [systemId], references: [id])
  systemId    String
  filename    String
  path        String
  size        Int
  contentType String?
  status      String   @default("uploaded")
  metadata    Json?
  uploadedAt  DateTime @default(now())
}

model UploadSession {
  id          String   @id @default(cuid())
  userId      String?
  systemId    String
  filename    String
  key         String
  uploadId    String
  size        Int
  contentType String?
  parts       Json?    // { partNumber: { etag, uploadedAt } }
  status      String   @default("initiated")
  createdAt   DateTime @default(now())
}
